# Configuração local de desenvolvimento.
#
# Gerada a partir de .env.example, com duas correções que o quickstart.md ainda
# não tem (tarefas de convergência T121/T125):
#   - o binário lê SOMENTE variáveis IRONLEDGER_*, não DATABASE_URL/KEYCLOAK_*;
#   - não existe realm do Keycloak no docker-compose, então IRONLEDGER_KEYCLOAK_REALM_URL
#     aponta para o servidor de JWKS local (devauth) em vez do Keycloak.
#
# Copie para .env e ajuste. `make run` carrega este arquivo.

IRONLEDGER_ENV=development
IRONLEDGER_LOG_LEVEL=debug
IRONLEDGER_HTTP_ADDR=:8080

# Sobe como superuser porque as roles ironledger_app/reader/migrator são criadas
# pela migration 010 e ainda não têm LOGIN (tarefa de convergência T117).
# Em produção isto deveria ser o DSN da role de aplicação.
IRONLEDGER_DATABASE_URL=postgres://postgres:postgres@localhost:55432/iron_ledger_dev?sslmode=disable
IRONLEDGER_RUN_MIGRATIONS=true

# Keycloak. O devauth serve o JWKS e emite tokens com iss/aud/azp/scope corretos.
# Troque pelo Keycloak real quando o compose tiver o realm exportado (T125).
IRONLEDGER_KEYCLOAK_REALM_URL=http://localhost:9090/realms/tenant-br
IRONLEDGER_KEYCLOAK_JWKS_URL=http://localhost:9090/realms/tenant-br/protocol/openid-connect/certs
IRONLEDGER_KEYCLOAK_AUDIENCE=ironledger-api
IRONLEDGER_KEYCLOAK_ALLOWED_CLIENTS=betting-provider,settlement-engine

IRONLEDGER_WRITE_SCOPE=wallet:write
IRONLEDGER_READ_SCOPE=wallet:read

IRONLEDGER_DB_MAX_CONNS=20
IRONLEDGER_DB_MIN_CONNS=2
IRONLEDGER_DB_STATEMENT_TIMEOUT=10s
IRONLEDGER_SHUTDOWN_TIMEOUT=25s
