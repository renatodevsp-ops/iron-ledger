{
  "realm": "ironledger",
  "enabled": true,
  "displayName": "Iron Ledger",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "internal",
        "description": "Grants access to the platform's own wallet operations."
      }
    ]
  },
  "clients": [
    {
      "clientId": "iron-ledger-internal",
      "name": "Iron Ledger internal service",
      "description": "Service account allowed to open wallets, read balances and reconcile.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "iron-ledger-internal-secret",
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic",
        "email"
      ],
      "defaultRoles": [
        "internal"
      ],
      "protocolMappers": [
        {
          "name": "iron-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "iron-ledger-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-a",
      "name": "Game provider A",
      "description": "Service account acting as game provider A.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "provider-a-secret",
      "attributes": {
        "providerId": "provider-a",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "iron-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "iron-ledger-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "iron-ledger-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B",
      "description": "Service account acting as game provider B. Used to prove providers are isolated from each other.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "provider-b-secret",
      "attributes": {
        "providerId": "provider-b",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "iron-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "iron-ledger-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "iron-ledger-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "iron-ledger-api",
      "name": "Iron Ledger API audience",
      "description": "Audience resource server so provider tokens carry aud=iron-ledger.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "secret": "iron-ledger-api-secret"
    }
  ],
  "users": [
    {
      "username": "internal-service",
      "enabled": true,
      "serviceAccountClientId": "iron-ledger-internal",
      "realmRoles": [
        "internal"
      ]
    },
    {
      "username": "provider-a-service",
      "enabled": true,
      "serviceAccountClientId": "provider-a"
    },
    {
      "username": "provider-b-service",
      "enabled": true,
      "serviceAccountClientId": "provider-b"
    }
  ]
}
