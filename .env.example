# Local environment for the iron-ledger platform.
#
# Every value here is a local development default. There are no real secrets:
# the client secrets belong to the test identities of the local Keycloak realm in
# deploy/keycloak/realm-ironledger.json, and the AWS credentials are the values
# LocalStack accepts. Copy this file to .env and adjust; `docker compose` reads
# .env automatically.

# ── service ───────────────────────────────────────────────────────────────────
IRONLEDGER_ENV=local
IRONLEDGER_SERVICE_NAME=iron-ledger
LOG_LEVEL=info
# INSTANCE_ID defaults to the hostname and pid; set it when running several
# instances locally so the logs can be told apart.
# INSTANCE_ID=api-1

# ── http ──────────────────────────────────────────────────────────────────────
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_BUDGET=20s
HTTP_MAX_BODY_BYTES=1048576

# ── postgresql ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://iron:iron@localhost:5432/ironledger?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=5s
# Applies pending migrations on boot. Convenient locally; in a deployment a
# migration job would run these instead.
DATABASE_MIGRATE_ON_BOOT=true
MIGRATIONS_DIR=migrations

# ── sqs ───────────────────────────────────────────────────────────────────────
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Leave the URLs empty to have the application provision the queues and resolve
# their URLs by name.
SQS_WAGER_QUEUE_URL=
SQS_WAGER_DLQ_URL=
SQS_EVENTS_QUEUE_URL=
SQS_VISIBILITY_TIMEOUT=30s
SQS_WAIT_TIME=5s
SQS_MAX_MESSAGES=10
# maxReceiveCount of both redrive policies: after this many deliveries a message
# lands in the dead-letter queue.
SQS_MAX_ATTEMPTS=5

# ── identity (Keycloak) ───────────────────────────────────────────────────────
AUTH_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8081/realms/ironledger
OIDC_AUDIENCE=iron-ledger-api
AUTH_INTERNAL_CLIENT_ID=iron-ledger-internal
AUTH_INTERNAL_ROLE=internal
AUTH_ROLE_CLAIM=roles
AUTH_PROVIDER_CLAIM=providerId
# Fallback for identity providers that do not project a provider claim: maps an
# OAuth client id to the provider it may act as.
AUTH_CLIENT_PROVIDERS=provider-a=provider-a,provider-b=provider-b
AUTH_LEEWAY=30s

# ── wagering ──────────────────────────────────────────────────────────────────
# How long a reversal may wait for its reference before being rejected.
WAGERING_MAX_REFERENCE_ATTEMPTS=8
WAGERING_REFERENCE_BACKOFF_BASE=2s
WAGERING_REFERENCE_BACKOFF_MAX=2m
# How often the resolver sweeps for reversals whose attempt is due.
WAGERING_PENDING_RESUME_INTERVAL=5s
# How many times one business operation may lose an optimistic-concurrency race
# before the request fails as a dependency problem.
WAGERING_MAX_CONFLICT_RETRIES=8

# ── outbox ────────────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=50
# How long a publisher owns a claimed row before another publisher may take it.
OUTBOX_VISIBILITY_WINDOW=30s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=1m

# ── shutdown ──────────────────────────────────────────────────────────────────
SHUTDOWN_SIGNAL_TIMEOUT=30s
