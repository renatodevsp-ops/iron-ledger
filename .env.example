# Local development configuration.
#
# Copy to .env and adjust. Every variable here is read by
# internal/platform/config; the process refuses to start if a required one is
# missing or nonsensical, so this file is the complete list.

IRONLEDGER_ENV=development
IRONLEDGER_LOG_LEVEL=debug

# The service. Nothing but the API port is opened.
IRONLEDGER_HTTP_ADDR=:8080

# Required. The application role, not a superuser: it cannot run DDL and cannot
# write audit_log, operations or ledger_entries.
IRONLEDGER_DATABASE_URL=postgres://ironledger:ironledger@localhost:5432/ironledger?sslmode=disable

# Convenient locally, dangerous in production: it lets every replica race to
# apply DDL. Prefer running migrations as a separate deploy step.
IRONLEDGER_RUN_MIGRATIONS=true

# Keycloak. The realm URL is also the tenant identity when a realm-per-tenant
# topology is used, and it must match the token's `iss` exactly.
IRONLEDGER_KEYCLOAK_REALM_URL=http://localhost:8081/realms/tenant-br
IRONLEDGER_KEYCLOAK_JWKS_URL=http://localhost:8081/realms/tenant-br/protocol/openid-connect/certs
IRONLEDGER_KEYCLOAK_AUDIENCE=ironledger-api
IRONLEDGER_KEYCLOAK_ALLOWED_CLIENTS=betting-provider,settlement-engine

# Scope names the tokens must carry.
IRONLEDGER_WRITE_SCOPE=wallet:write
IRONLEDGER_READ_SCOPE=wallet:read

# Pool sizing and the per-statement timeout that bounds any single lock hold.
IRONLEDGER_DB_MAX_CONNS=20
IRONLEDGER_DB_MIN_CONNS=2
IRONLEDGER_DB_STATEMENT_TIMEOUT=10s

# Graceful drain budget.
IRONLEDGER_SHUTDOWN_TIMEOUT=25s
